# ===== 模型（必填）=====
# LLM API Key（OpenAI 兼容接口）
ARK_API_KEY=
# OpenAI 兼容接口地址
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主模型名
MODEL=qwen3.8-flash

# 评分/重写用模型
GRADE_MODEL=deepseek-v4-flash-0731

# 向量模型
EMBEDDER=qwen3.7-text-embedding
EMBEDDING_DIM=1536

# RAG辅助小模型(改写/扩展),主力模型仍是上面的MODEL
REWRITE_MODEL=deepseek-v4-flash-0731
EXPAND_MODEL=qwen-flash

# 模型选型: 主对话/路由改写/评分/嵌入/重排/兜底/评测
ROUTER_MODEL=deepseek-v4-flash-0731
RERANK_MODEL=qwen3.7-text-rerank
RERANK_BINDING_HOST=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
FALLBACK_MODEL=qwen3.8-max
EVAL_MODEL=glm-5.2
RERANK_API_KEY=
MAIN_MODEL_THINKING=false

# ===== RAG =====
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3

# ===== RAGAS 评测（缺省复用上面的模型配置）=====
RAGAS_EMBEDDING_MODEL=qwen3.7-text-embedding

# ===== 基础服务（默认值对应根目录 docker-compose.yml）=====
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_DATABASE=rag_mysql

REDIS_URL=redis://localhost:6379/0

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_embeddings

# ===== JWT 鉴权 =====
# 生产环境务必修改
JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# 注册邀请码，为空则不校验
ADMIN_INVITE_CODE=admin

# ===== MCP 工具 =====
# 开启后加载 Git / MySQL 等 MCP 工具
MCP_ENABLED=enabled

# ===== 日志 =====
# development 彩色输出 / production JSON
ENV=development
LOG_LEVEL=INFO

# 高德天气工具(weather_tools.py)——key需在 https://lbs.amap.com 申请「Web服务」类型
WEATHER_API=https://restapi.amap.com/v3/weather/weatherInfo
GEOCODE_API=https://restapi.amap.com/v3/geocode/geo
WEATHER_API_KEY=


# LangSmith链路观测(填好key后把下面改为true并重启后端)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=TraceAgentic
